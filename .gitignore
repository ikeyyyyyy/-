# 依赖（本项目零依赖，保留以防后续引入工具链）
node_modules/
.pnpm-store/

# 运行期数据：数据库文件与用户上传的原图，绝不入库
backend/data/db.json
backend/data/db.json.tmp
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/*.log

# 环境变量：只提交 .env.example
.env
.env.*
!.env.example

# 工作区辅助数据（本地记忆/草稿，不属于代码）
.workbuddy/
# 发布应用时由工具生成的标记文件
*.genie

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 测试与截图临时产物
coverage/
*.tmp
_p*.html
_smoke.html

# 构建产物：由 scripts/build-standalone.mjs 生成，不入库
#   dist/                    单文件版 HTML（直接发给人）
#   standalone-web/          同一份内容的静态站目录（发布公网链接用）
dist/
standalone-web/
