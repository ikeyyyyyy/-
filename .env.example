# ============================================================================
# English Essay Grader - 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 本文件不包含任何真实密钥，请勿把 .env 提交到仓库。
# ============================================================================

# ---------- 服务 ----------
PORT=8787
HOST=127.0.0.1
# 前端页面通过 ?api= 或 localStorage 覆盖时，此处作为默认值
# 与 HOST 保持一致用 127.0.0.1：localhost 与 127.0.0.1 在浏览器里是两个 origin，混用会被判跨域
EG_PUBLIC_BASE_URL=http://127.0.0.1:8787

# ---------- 存储 ----------
# JSON 文件存储的目录（默认 backend/data），上传文件落在 uploads/ 下
EG_DATA_DIR=./backend/data
EG_UPLOAD_DIR=./backend/data/uploads
EG_DB_FILE=./backend/data/db.json

# 单次上传体积上限（MB）
MAX_UPLOAD_MB=12

# ---------- OCR 引擎（可插拔） ----------
# 可选：mock | paddle | vlm | cloud
# mock  = 只回放 sample_data/ocr_fixtures 里的 demo 转录，用于课堂演示与测试，
#         不会真的识别图片；返回结果里 engine 字段会标成 mock。
# paddle= 调用自建 PaddleOCR HTTP 服务（需配置 PADDLEOCR_ENDPOINT）
# vlm   = 调用视觉大模型做整页转录（需配置 VLM_ENDPOINT / VLM_MODEL）
# cloud = 调用云厂商 OCR（通用 HTTP 契约，需配置 CLOUD_OCR_ENDPOINT）
OCR_ENGINE=mock
OCR_LANG=en
# 低于该置信度标记 needs_review（仍然可以送评分）
OCR_CONFIDENCE_THRESHOLD=0.75

# PaddleOCR 服务（POST JSON {image_base64, lang} -> {text|results, confidence}）
PADDLEOCR_ENDPOINT=
PADDLEOCR_API_KEY=
PADDLEOCR_TIMEOUT_MS=20000

# VLM（OpenAI 兼容 /chat/completions 端点）
VLM_ENDPOINT=
VLM_MODEL=
VLM_API_KEY=
VLM_TIMEOUT_MS=45000

# 云 OCR（POST JSON {image_base64, mime} -> {text, confidence}）
CLOUD_OCR_PROVIDER=
CLOUD_OCR_ENDPOINT=
CLOUD_OCR_KEY=
CLOUD_OCR_TIMEOUT_MS=20000

# ---------- 启动行为 ----------
# 设为 1 时，服务启动成功后自动用默认浏览器打开批改页
# start.cmd / start.sh 会自动设置，手动 npm start 时默认不打开
EG_OPEN=0

# ---------- 学习分析 ----------
# 顽固错误判定：至少出现在多少次提交里（默认 2）
ANALYTICS_STUBBORN_MIN_OCCURRENCES=2
# 认定为"优势项"的归一化分下限（0-10）
ANALYTICS_STRENGTH_MIN_SCORE=7
